{
  "name": "samra-portfolio",
  "version": "1.0.0",
  "description": "Public portfolio and browser-local Jobs workspace",
  "scripts": {
    "build": "esbuild admin/jobs/src/app.js --bundle --format=esm --minify --outfile=admin/jobs/dist/app.js",
    "test": "node --test tests/core.test.js tests/policies.test.js tests/inbox.test.js",
    "test:browser": "playwright test",
